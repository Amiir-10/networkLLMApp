# Connection details for the CURRENT vast.ai instance.
# Copy to scripts/vast-instance.env (gitignored) and fill in after renting.
# Get values from `vastai ssh-url <INSTANCE_ID>` → ssh://root@HOST:PORT
#
# Consumed by: scripts/vast-tunnel.sh, scripts/sync-results.sh,
#              the vast-sync systemd timer (via sync-results.sh)

SSH_HOST=ssh4.vast.ai        # or the direct IP for --direct instances
SSH_PORT=12345
SSH_USER=root
# Repo location ON THE INSTANCE (Path B only; ignored by the tunnel script)
REMOTE_REPO_DIR=/root/networkLLMApp
